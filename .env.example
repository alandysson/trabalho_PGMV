# =========================================================================
# Vídeos Narrados — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha conforme necessário.
# Variáveis sem default razoável quebram a aplicação se ausentes.
# =========================================================================

# -------------------------------------------------------------------------
# Backend FastAPI (esta sessão arquitetural)
# -------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development

# URL do banco SQLModel/SQLAlchemy. Default = SQLite local (ADR-0006).
# Para Postgres, ex.: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./videos.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Origens autorizadas para CORS — JSON array. Vazio = CORS desativado
# (o backend não responde a preflights → só requests same-origin funcionam).
# Em produção, listar EXPLICITAMENTE.
# Ex.: CORS_ORIGINS=["http://localhost:8081","https://meuapp.com"]
CORS_ORIGINS=[]

# Regex de origens permitidas (complementa CORS_ORIGINS).
# Útil em dev com Expo: ^exp://.* casa qualquer `exp://192.168.x.x:19000`.
# Em produção, deixe vazio.
CORS_ORIGIN_REGEX=

# Diretório raiz para arquivos gerados (vídeos, áudios, transcrições).
STORAGE_DIR=storage

# -------------------------------------------------------------------------
# Auth (feature `auth`) — ver ADR-0009
# -------------------------------------------------------------------------

# Gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA commitar. Em produção, vir de secrets manager.
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Custo bcrypt (4-15). 12 = ~250ms em hardware modesto.
BCRYPT_ROUNDS=12

# Rate limit do /auth/login (tentativas por janela por IP).
RATE_LIMIT_LOGIN_TENTATIVAS=5
RATE_LIMIT_LOGIN_JANELA_MINUTOS=15

# -------------------------------------------------------------------------
# Temas — sugeridor dinâmico via Claude
# -------------------------------------------------------------------------

# Anthropic — https://console.anthropic.com/ (Settings → API Keys).
# Pode ficar vazio em dev: sem chave, providers caem no catálogo
# estático puro. Quando configurado, ao esgotar o catálogo o provider
# pede sugestões novas ao Claude (Haiku) e cacheia na tabela
# `historias_sugeridas`.
ANTHROPIC_API_KEY=

ANTHROPIC_MODELO_SUGERIDOR=claude-haiku-4-5-20251001
ANTHROPIC_MODELO_ROTEIRO=claude-sonnet-4-6
ANTHROPIC_MODELO_CENAS=claude-haiku-4-5-20251001
ANTHROPIC_MODELO_POST=claude-haiku-4-5-20251001

# -------------------------------------------------------------------------
# Pipeline de geração de vídeo (features `pipeline` + `videos`)
# -------------------------------------------------------------------------

# Pexels API — https://www.pexels.com/api/  (gratuito, 200 req/h)
PEXELS_API_KEY=

# Voz do edge-tts. Outras opções pt-BR:
#   pt-BR-AntonioNeural   (masculina, séria)  ← padrão
#   pt-BR-FranciscaNeural (feminina, calorosa)
#   pt-BR-ThalitaNeural   (feminina, jovem)
TTS_VOICE=pt-BR-AntonioNeural

# Duração-alvo do vídeo em segundos.
VIDEO_DURACAO_ALVO=60

# Modelo Whisper para transcrição.
#   tiny   — ~75MB,  rápido, qualidade ok
#   base   — ~150MB, equilíbrio recomendado
#   small  — ~500MB, melhor precisão
#   medium — ~1.5GB, muito preciso, lento em CPU
WHISPER_MODEL=base

# Limite de jobs simultâneos. POST /videos/gerar retorna 429 se ultrapassar.
MAX_JOBS_PARALELOS=2

# Pasta com trilhas instrumentais MP3 para fundo (opcional, vazia = sem música).
PASTA_MUSICAS=assets/music

# -------------------------------------------------------------------------
# Pipeline legado (notificação por e-mail — não usado pelo backend)
# -------------------------------------------------------------------------

# Gmail SMTP — usado pelo legacy/notificacao.py (CLI antigo). Backend não usa.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DEST=
