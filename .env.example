# =========================================================================
# Pipeline de Vídeos Bíblicos — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves reais.
# =========================================================================

# Anthropic — https://console.anthropic.com/
# Crie uma chave em Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Pexels API — https://www.pexels.com/api/
# Cadastro gratuito; chave aparece na hora no painel
PEXELS_API_KEY=...

# Gmail SMTP — gerar senha de app em https://myaccount.google.com/apppasswords
# (requer 2FA ativado na conta Google)
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_DEST=seuemail@gmail.com

# =========================================================================
# Configurações opcionais (defaults razoáveis se não preenchidas)
# =========================================================================

# Voz do edge-tts. Outras opções pt-BR:
#   pt-BR-AntonioNeural  (masculina, séria)  ← padrão
#   pt-BR-FranciscaNeural (feminina, calorosa)
#   pt-BR-ThalitaNeural  (feminina, jovem)
TTS_VOICE=pt-BR-AntonioNeural

# Duração-alvo do vídeo em segundos (50-70 é o sweet spot para Kwai/TikTok)
VIDEO_DURACAO_ALVO=60

# Modelo Whisper. Quanto maior, mais preciso e mais lento.
#   tiny   — ~75MB, rápido, qualidade ok
#   base   — ~150MB, equilíbrio recomendado
#   small  — ~500MB, melhor precisão
#   medium — ~1.5GB, muito preciso, lento em CPU
WHISPER_MODEL=base
